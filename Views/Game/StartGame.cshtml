@model MinesweeperWeb.Models.StartGameViewModel

@{
    ViewData["Title"] = "Start Game";
}

<!--
    StartGame View
    Purpose:
    - Allows the logged-in user to select board size and difficulty.
    - Submits settings to GameController.StartGame (POST).
-->
<h2>Start Game</h2>

<form asp-action="StartGame" asp-controller="Game" method="post">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label asp-for="BoardSize" class="form-label">Board Size</label>
        <select asp-for="BoardSize" class="form-select">
            <option value="6">6 x 6</option>
            <option value="8">8 x 8</option>
            <option value="10">10 x 10</option>
            <option value="12">12 x 12</option>
            <option value="16">16 x 16</option>
        </select>
        <span asp-validation-for="BoardSize" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Difficulty" class="form-label">Difficulty</label>
        <select asp-for="Difficulty" class="form-select">
            <option value="Easy">Easy</option>
            <option value="Medium">Medium</option>
            <option value="Hard">Hard</option>
        </select>
        <span asp-validation-for="Difficulty" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Start Game</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

