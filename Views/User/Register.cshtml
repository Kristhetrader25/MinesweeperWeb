@model MinesweeperWeb.Models.User

@{
    ViewData["Title"] = "Register";
}

<!--
    Register View
    Purpose:
    - Displays a strongly-typed registration form bound to the User model.
    - Submits data via HTTP POST back to UserController.Register(User user).
    - Displays server-side validation errors using Tag Helpers + ModelState.
-->
<h2>Register</h2>

<form asp-action="Register" asp-controller="User" method="post">
    @Html.AntiForgeryToken()

    <div>
        <label asp-for="FirstName"></label>
        <input asp-for="FirstName" />
        <span asp-validation-for="FirstName"></span>
    </div>

    <div>
        <label asp-for="LastName"></label>
        <input asp-for="LastName" />
        <span asp-validation-for="LastName"></span>
    </div>

    <div>
        <label asp-for="Sex"></label>
        <input asp-for="Sex" />
        <span asp-validation-for="Sex"></span>
    </div>

    <div>
        <label asp-for="Age"></label>
        <input asp-for="Age" type="number" />
        <span asp-validation-for="Age"></span>
    </div>

    <div>
        <label asp-for="State"></label>
        <input asp-for="State" maxlength="2" />
        <span asp-validation-for="State"></span>
    </div>

    <div>
        <label asp-for="EmailAddress"></label>
        <input asp-for="EmailAddress" type="email" />
        <span asp-validation-for="EmailAddress"></span>
    </div>

    <div>
        <label asp-for="Username"></label>
        <input asp-for="Username" />
        <span asp-validation-for="Username"></span>
    </div>

    <div>
        <label asp-for="Password"></label>
        <input asp-for="Password" type="password" />
        <span asp-validation-for="Password"></span>
    </div>

    <button type="submit">Register</button>
</form>

@section Scripts {
    <!--
        Enables client-side validation messages.
        Server-side validation still runs in controller (ModelState).
    -->
    <partial name="_ValidationScriptsPartial" />
}

