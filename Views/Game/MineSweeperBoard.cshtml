@model List<MinesweeperWeb.Models.CellButtonModel>

@{
    ViewData["Title"] = "MineSweeper Board";

    /*
        Feature Toggle:
        - Milestone # requires Right-click enabled.
    */
    bool enableRightClickFlagging = true;
}

<!--
    MineSweeperBoard View
    Purpose:
    - Displays a 2D board using a List model.
    - Left-click submits to CellClick (reveal).
    - Right-click (flag/unflag) is disabled for Milestone 2 by default via the toggle above.
-->

<h2>Minesweeper Board</h2>

<p><strong>Board Size:</strong> @ViewBag.BoardSize x @ViewBag.BoardSize</p>
<p><strong>Difficulty:</strong> @ViewBag.Difficulty</p>

<p><strong>Last AJAX Update:</strong> <span id="ajax-timestamp">@DateTime.Now.ToLongTimeString()</span></p>

@if (ViewBag.GameStatus != null)
{
    var status = (MinesweeperWeb.Models.Board.GameStatus)ViewBag.GameStatus;

    if (status == MinesweeperWeb.Models.Board.GameStatus.Lost)
    {
        <h3 style="color:red;">Game Over — You hit a bomb!</h3>
    }
    else if (status == MinesweeperWeb.Models.Board.GameStatus.Won)
    {
        <h3 style="color:green;">Congratulations — You won!</h3>
    }
}

<link rel="stylesheet" href="~/css/buttons.css" />

<!--
    Restart button (POST) - creates a new board for the current user
    while keeping the current session settings (size/difficulty).
-->
<form asp-action="Restart" method="post" style="margin-bottom: 15px;">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-secondary">Restart Game</button>
</form>

<!--
    Save Game button (POST)
    - Saves the current board state for the logged-in user into the Games table.
-->
<form asp-action="SaveGame" method="post" style="margin-bottom: 15px;">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-primary">Save Game</button>
</form>


@if (enableRightClickFlagging)
{
    <!--
        Hidden Flag Form (POST)
        - Used for right-click flagging.
        - Includes AntiForgeryToken for secure posting.
        - JavaScript sets the hidden "id" value then submits this form.
    -->
    <form id="flagForm" asp-action="ToggleFlag" asp-controller="Game" method="post" style="display:none;">
        @Html.AntiForgeryToken()
        <input type="hidden" id="flagId" name="id" value="" />
    </form>
}

<!--
    Main Board Form (POST)
    - Left-click submits the clicked cell id to CellClick.
    - Right-click is enabled for Milestone 3.
-->
<form asp-action="CellClick" method="post">
    @Html.AntiForgeryToken()

    <div class="board-container" style="--board-size:@ViewBag.BoardSize;">
        @for (int i = 0; i < Model.Count; i++)
        {
            var cell = Model[i];

            <div oncontextmenu="@(enableRightClickFlagging ? $"event.preventDefault(); flagCell({cell.Id});" : "return false;")">
                <partial name="_Cell" model="cell" />
            </div>
        }
    </div>
</form>

@if (enableRightClickFlagging)
{
    <script>
        /*
            Right-click helper:
            Submits the hidden "ToggleFlag" form with the clicked cell id.
            Uses a hidden form so ASP.NET anti-forgery token is included.
        */
        function flagCell(id) {
            document.getElementById('flagId').value = id;
            document.getElementById('flagForm').submit();
        }
    </script>
}

<script>
    /*
        AJAX left-click handler:
        - Sends the clicked cell id to RevealCellAjax
        - If the game is still in progress, replaces only that one cell
        - If the game ends, redirects to Win or Loss
        - Updates the timestamp to prove the page did not fully reload
    */
    document.addEventListener("DOMContentLoaded", function () {
        const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');

        document.querySelectorAll(".cell-btn").forEach(button => {
            button.addEventListener("click", function () {
                const cellId = this.getAttribute("data-cell-id");
                const token = tokenInput ? tokenInput.value : "";

                fetch('@Url.Action("RevealCellAjax", "Game")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8'
                    },
                    body: `__RequestVerificationToken=${encodeURIComponent(token)}&id=${encodeURIComponent(cellId)}`
                })
                .then(async response => {
                    const contentType = response.headers.get("content-type") || "";

                    // If controller returned JSON, the game ended and we should redirect.
                    if (contentType.includes("application/json")) {
                        const data = await response.json();
                        if (data.redirectUrl) {
                            window.location.href = data.redirectUrl;
                            return null;
                        }
                    }

                    // Otherwise controller returned the updated cell partial HTML.
                    return response.text();
                })
                .then(html => {
                    if (!html) return;

                    const target = document.getElementById(`cell-${cellId}`);
                    if (target) {
                        target.outerHTML = html;
                    }

                    // Update timestamp to demonstrate AJAX partial update.
                    const timestamp = document.getElementById("ajax-timestamp");
                    if (timestamp) {
                        timestamp.textContent = new Date().toLocaleTimeString();
                    }
                })
                .catch(error => console.error("AJAX cell update failed:", error));
            });
        });
    });
</script>